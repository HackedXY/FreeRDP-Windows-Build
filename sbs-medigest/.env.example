# Copier en .env et remplir. NE JAMAIS versionner le fichier .env.
# Recommandé : générer ce fichier avec  ./deploy/scripts/generate-secrets.sh <domaine> <email>
DOMAIN=sbs.exemple.gn
ACME_EMAIL=admin@exemple.gn
# Mots de passe PostgreSQL distincts par rôle (openssl rand -base64 24)
DB_ADMIN_PASSWORD=
OWNER_DB_PASSWORD=
APP_DB_PASSWORD=
BACKUP_DB_PASSWORD=
# Clé HMAC de signature du journal d'audit (openssl rand -base64 32) — à conserver hors du serveur également
AUDIT_HMAC_KEY=
# Clé de chiffrement des données médicales (32 octets base64) : openssl rand -base64 32
# ⚠️ À conserver précieusement hors du serveur : sans elle, les données médicales chiffrées sont illisibles.
DATA_ENCRYPTION_KEY=
# Sauvegardes : destination distante (jamais le serveur de base de données)
# Identifiants du stockage : fichier secrets/rclone.env (RCLONE_CONFIG_DISTANT_TYPE=s3, …_ACCESS_KEY_ID, …)
BACKUP_TARGET=rclone:distant:sbs-sauvegardes
# Clé publique : secrets/backup-public.pem (voir « Sauvegardes » dans le README) — la clé PRIVÉE ne va jamais sur le serveur
ADMIN_USERNAME=admin
# Mot de passe initial de l'admin (changement imposé à la 1re connexion). Vide = généré et affiché dans les logs.
ADMIN_PASSWORD=
# Déconnexion automatique après inactivité, en minutes (1 à 720 ; défaut 30)
SESSION_IDLE_MINUTES=30
# Rétention : confiée au stockage distant (verrouillage d'objets + cycle de vie), voir docs/SAUVEGARDES.md
# BACKUP_REMOTE_PRUNE=off : le serveur ne supprime jamais de sauvegarde (ses identifiants n'en ont pas le droit)
BACKUP_REMOTE_PRUNE=off
BACKUP_KEEP_DAYS=30
BACKUP_HOUR=2
