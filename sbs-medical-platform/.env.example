# Copier en .env et remplir. NE JAMAIS versionner le fichier .env.
DOMAIN=sbs.exemple.gn
# Mots de passe PostgreSQL distincts par rôle (openssl rand -base64 24)
DB_ADMIN_PASSWORD=
OWNER_DB_PASSWORD=
APP_DB_PASSWORD=
BACKUP_DB_PASSWORD=
# Clé HMAC de signature du journal d'audit (openssl rand -base64 32) — à conserver hors du serveur également
AUDIT_HMAC_KEY=
# Clé de chiffrement des données médicales (32 octets base64) : openssl rand -base64 32
# ⚠️ À conserver précieusement hors du serveur : sans elle, les données médicales chiffrées sont illisibles.
DATA_ENCRYPTION_KEY=
# Phrase de chiffrement des sauvegardes (également à conserver hors du serveur)
BACKUP_PASSPHRASE=
ADMIN_USERNAME=admin
# Mot de passe initial de l'admin (changement imposé à la 1re connexion). Vide = généré et affiché dans les logs.
ADMIN_PASSWORD=
BACKUP_KEEP_DAYS=30
BACKUP_HOUR=2
