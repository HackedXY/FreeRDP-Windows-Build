{
  "name": "sbs-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API de la plateforme de gestion du Cabinet Médical SBS",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "demo": "node src/db/demo.js",
    "test": "node --test --test-concurrency=1 --test-timeout=120000 test/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie": "^2.0.1",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "socket.io": "^4.8.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.3",
    "supertest": "^7.3.0"
  }
}
